{
  "name": "neon-snake-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "React dashboard for Neon Snake gameplay analytics, served from the local analytics backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
